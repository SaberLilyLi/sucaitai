# DeepSeek API（可选：自然语言解析搜索意图；复制为 .env 后填写）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 万邦 Onebound（必填）https://open.onebound.cn/
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=

# 淘宝（默认）
ONEBOUND_API_BASE=https://api-gw.onebound.cn/taobao/
ONEBOUND_API_URL=https://api-gw.onebound.cn/taobao/item_search/
ONEBOUND_ITEM_GET_URL=https://api-gw.onebound.cn/taobao/item_get/

# 1688 阿里巴巴（与淘宝共用 Key；路径不同）
ONEBOUND_1688_API_BASE=https://api-gw.onebound.cn/1688/
ONEBOUND_1688_API_URL=https://api-gw.onebound.cn/1688/item_search/
ONEBOUND_1688_ITEM_GET_URL=https://api-gw.onebound.cn/1688/item_get/
